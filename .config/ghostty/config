theme = lackluster
# Terminal
command = /opt/homebrew/bin/nu
shell-integration-features = no-cursor, no-sudo, title
mouse-hide-while-typing = true
confirm-close-surface=false
# macos-icon = custom-style
# macos-icon-ghost-color = #708090
# macos-icon-screen-color = #deeeed
# macos-icon = blueprint
# macos-icon = paper
macos-icon = custom
macos-custom-icon = ~/Documents/devs/icons/ghostty_pink.png

# Window
macos-titlebar-style = hidden
window-padding-x = 12
window-padding-y = 12
background-opacity = 1

# Fonts
font-family = "JetBrainsMono Nerd Font Mono"
font-style = Medium
font-size = 18
adjust-cell-height = 28
adjust-cell-width = 1

# Cursor
cursor-style = block
cursor-style-blink = false
shell-integration-features = no-cursor

# Keybinds
keybind = clear
keybind = super+v=paste_from_clipboard
keybind = super+c=copy_to_clipboard
keybind = super+q=quit
