# This is the configuration file for Ghostty.
#
# This template file has been automatically created at the following
# path since Ghostty couldn't find any existing config files on your system:
#
#   /Users/somleff/Library/Application Support/com.mitchellh.ghostty/config
#

theme = lackluster
# Terminal
command = /opt/homebrew/bin/nu

# Window
macos-titlebar-style = hidden
window-padding-x = 8
window-padding-y = 8
background-blur-radius = 20
background-opacity = 1.0

# Fonts
font-family = "JetBrainsMono Nerd Font Mono"
font-style = Medium
font-size = 18
# Ghostty automatically maps bold/italic styles based on the font family.
# Alacritty's global y-offsets are handled by cell adjustments in Ghostty.
# You may need to tweak these numbers to get the exact spacing you had in Alacritty.
adjust-cell-height = 28

# Cursor
cursor-style = block
cursor-style-blink = true
